// Components/CvrAutoCompleteForm.razor
@using System.Text.Json
@using System.Timers
@using BlazorWebPoc.Web.Models
@using MudBlazor
@using BlazorWebPoc.Web.Client
@inject CvrClient CvrClient
@inject ISnackbar Snackbar
@inject ILogger<CvrAutoCompleteForm> Logger
@implements IDisposable

<MudCard>
    <MudCardContent>
        <MudText Typo="Typo.h6" GutterBottom="true">Company Information Form</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="CvrAutoCompleteItem"
                                 Label="CVR Number"
                                 Value="selectedCvr"
                                 ValueChanged="OnCvrSelected"
                                 SearchFunc="@SearchCvr"
                                 ToStringFunc="@(item => item?.Text ?? string.Empty)"
                                 ShowProgressIndicator="@isSearching"
                                 ProgressIndicatorColor="Color.Primary"
                                 MinCharacters="3"
                                 MaxItems="10"
                                 Variant="Variant.Outlined"
                                 HelperText="@GetHelperText()"
                                 Culture="@danishCulture"
                                 DebounceInterval="500"
                                 Disabled="@isLoading">

                    <ItemTemplate Context="item">
                        <MudStack Row>
                            <MudIcon Icon="Icons.Material.Filled.Business" Size="Size.Small" />
                            <MudText>@((MarkupString)FormatDisplayText(item.Text))</MudText>
                        </MudStack>
                    </ItemTemplate>
                    <ItemSelectedTemplate Context="item">
                        <MudText>@((MarkupString)FormatDisplayText(item.Text))</MudText>
                    </ItemSelectedTemplate>
                    <NoItemsTemplate>
                        <MudText Typo="Typo.body2" Class="pa-4">
                            @if (isSearching)
                            {
                                <MudText>Searching...</MudText>
                            }
                            else if (!string.IsNullOrEmpty(lastErrorMessage))
                            {
                                <MudText Color="Color.Error">@lastErrorMessage</MudText>
                            }
                            else if (!string.IsNullOrEmpty(lastSearchValue) && lastSearchValue.Length >= 3)
                            {
                                <MudText>No companies found</MudText>
                            }
                            else
                            {
                                <MudText>Enter at least 3 characters to search</MudText>
                            }
                        </MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="companyForm.Name"
                              Label="Company Name"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Disabled="@isLoading" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="companyForm.Phone"
                              Label="Phone Number"
                              Variant="Variant.Outlined"
                              Disabled="@isLoading" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="companyForm.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Disabled="@isLoading" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="companyForm.Address"
                              Label="Address"
                              Variant="Variant.Outlined"
                              Disabled="@isLoading" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="companyForm.Zipcode"
                              Label="Zipcode"
                              Variant="Variant.Outlined"
                              Disabled="@isLoading" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="companyForm.City"
                              Label="City"
                              Variant="Variant.Outlined"
                              Disabled="@isLoading" />
            </MudItem>

            <MudItem xs="12">
                <MudStack Row Spacing="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="Icons.Material.Filled.Save"
                               OnClick="SaveForm"
                               Loading="@isSaving"
                               Disabled="@(!CanSave())">
                        Save Company Information
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="Icons.Material.Filled.Clear"
                               OnClick="ClearForm"
                               Disabled="@isLoading">
                        Clear
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>

        @if (lastSearchStats.HasValue)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Last search: @lastSearchStats.Value.ResultCount results in @lastSearchStats.Value.Duration.TotalMilliseconds ms
            </MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    private CvrAutoCompleteItem? selectedCvr;
    private CompanyForm companyForm = new();
    private readonly System.Globalization.CultureInfo danishCulture = new("da-DK");

    // State management
    private bool isSearching = false;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool isSelecting = false;

    // Error handling
    private string lastErrorMessage = string.Empty;
    private string lastSearchValue = string.Empty;

    // Performance tracking
    private SearchStats? lastSearchStats;
    private readonly Dictionary<string, CachedResult> searchCache = new();

    // Constants
    private const int CACHE_EXPIRY_MINUTES = 5;
    private const int MAX_CACHE_SIZE = 50;

    public class CompanyForm
    {
        public long? CvrNumber { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Zipcode { get; set; } = string.Empty;
    }

    private class CachedResult
    {
        public List<CvrAutoCompleteItem> Results { get; set; } = new();
        public DateTime CachedAt { get; set; }
        public string ErrorMessage { get; set; } = string.Empty;
        public bool IsError { get; set; }
    }

    private struct SearchStats
    {
        public int ResultCount { get; set; }
        public TimeSpan Duration { get; set; }
    }

    private string GetHelperText()
    {
        if (isSearching)
            return "Searching for companies...";

        if (!string.IsNullOrEmpty(lastErrorMessage))
            return lastErrorMessage;

        return "Enter at least 3 characters to search";
    }

    private bool CanSave() => !string.IsNullOrWhiteSpace(companyForm.Name) && !isLoading && !isSaving;

    private string FormatDisplayText(string text)
    {
        if (string.IsNullOrEmpty(text))
            return text;

        var processed = ProcessDanishText(text);
        var parts = processed.Split(" - ", 2);

        if (parts.Length == 2)
        {
            return $"<strong>{parts[0]}</strong> - {parts[1]}";
        }

        return processed;
    }

    private string ProcessDanishText(string input)
    {
        if (string.IsNullOrEmpty(input))
            return input;

        try
        {
            var processed = input
                .Replace("\\u00e6", "æ")  // æ
                .Replace("\\u00f8", "ø")  // ø
                .Replace("\\u00e5", "å")  // å
                .Replace("\\u00c6", "Æ")  // Æ
                .Replace("\\u00d8", "Ø")  // Ø
                .Replace("\\u00c5", "Å")  // Å
                .Replace("\\u00e9", "é")  // é
                .Replace("\\u00fc", "ü")  // ü
                .Replace("\\u00f6", "ö")  // ö
                .Replace("\\u00e4", "ä"); // ä

            processed = System.Net.WebUtility.HtmlDecode(processed);
            processed = System.Text.RegularExpressions.Regex.Unescape(processed);

            return processed.Trim();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Error processing Danish text: {Error}", ex.Message);
            return input;
        }
    }

    private void CleanCache()
    {
        var expiredKeys = searchCache
            .Where(kvp => DateTime.UtcNow - kvp.Value.CachedAt > TimeSpan.FromMinutes(CACHE_EXPIRY_MINUTES))
            .Select(kvp => kvp.Key)
            .ToList();

        foreach (var key in expiredKeys)
        {
            searchCache.Remove(key);
        }

        // Keep cache size manageable
        if (searchCache.Count > MAX_CACHE_SIZE)
        {
            var oldestKeys = searchCache
                .OrderBy(kvp => kvp.Value.CachedAt)
                .Take(searchCache.Count - MAX_CACHE_SIZE)
                .Select(kvp => kvp.Key)
                .ToList();

            foreach (var key in oldestKeys)
            {
                searchCache.Remove(key);
            }
        }
    }

    private async Task<IEnumerable<CvrAutoCompleteItem>> SearchCvr(string value, CancellationToken token)
    {
        lastErrorMessage = string.Empty;

        if (isSelecting)
        {
            return new List<CvrAutoCompleteItem>();
        }

        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
        {
            lastSearchValue = value;
            return new List<CvrAutoCompleteItem>();
        }

        // Clean cache periodically
        CleanCache();

        // Check cache first
        if (searchCache.TryGetValue(value, out var cached))
        {
            if (cached.IsError)
            {
                lastErrorMessage = cached.ErrorMessage;
                return new List<CvrAutoCompleteItem>();
            }
            return cached.Results;
        }

        lastSearchValue = value;
        isSearching = true;
        StateHasChanged();

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            Logger.LogDebug("Starting CVR search for: {Query}", value);

            var response = await CvrClient.SearchCvrAsync(value, token);

            stopwatch.Stop();

            if (!response.IsSuccess)
            {
                lastErrorMessage = response.Message;
                searchCache[value] = new CachedResult
                {
                    IsError = true,
                    ErrorMessage = response.Message,
                    CachedAt = DateTime.UtcNow
                };

                Logger.LogWarning("CVR search failed: {Message}", response.Message);
                return new List<CvrAutoCompleteItem>();
            }

            // Process Danish characters in results
            var processedResults = new List<CvrAutoCompleteItem>();
            foreach (var result in response.Results)
            {
                var processedResult = new CvrAutoCompleteItem
                {
                    Value = result.Value,
                    Text = ProcessDanishText(result.Text),
                    Data = new CvrSearchResult
                    {
                        Vat = result.Data.Vat,
                        Name = ProcessDanishText(result.Data.Name),
                        Phone = result.Data.Phone,
                        Email = result.Data.Email,
                        Address = ProcessDanishText(result.Data.Address),
                        City = ProcessDanishText(result.Data.City),
                        Zipcode = result.Data.Zipcode,
                        Country = result.Data.Country
                    }
                };
                processedResults.Add(processedResult);
            }

            // Cache successful results
            searchCache[value] = new CachedResult
            {
                Results = processedResults,
                CachedAt = DateTime.UtcNow
            };

            lastSearchStats = new SearchStats
            {
                ResultCount = processedResults.Count,
                Duration = stopwatch.Elapsed
            };

            Logger.LogDebug("CVR search completed: {Count} results in {Duration}ms",
                processedResults.Count, stopwatch.ElapsedMilliseconds);

            return processedResults;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            Logger.LogDebug("CVR search cancelled for: {Query}", value);
            return new List<CvrAutoCompleteItem>();
        }
        catch (Exception ex)
        {
            stopwatch.Stop();
            lastErrorMessage = "Search failed. Please try again.";

            Logger.LogError(ex, "Error during CVR search for: {Query}", value);

            searchCache[value] = new CachedResult
            {
                IsError = true,
                ErrorMessage = lastErrorMessage,
                CachedAt = DateTime.UtcNow
            };

            return new List<CvrAutoCompleteItem>();
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task OnCvrSelected(CvrAutoCompleteItem? selectedItem)
    {
        isSelecting = true;

        try
        {
            if (selectedItem?.Data != null)
            {
                selectedCvr = selectedItem;
                isLoading = true;
                StateHasChanged();

                // Simulate a small delay to show loading state
                await Task.Delay(100);

                // Auto-populate form fields
               
                companyForm.CvrNumber = selectedItem.Data.Vat;
                companyForm.Name = selectedItem.Data.Name;
                companyForm.Phone = selectedItem.Data.Phone;
                companyForm.Email = selectedItem.Data.Email;
                companyForm.Address = selectedItem.Data.Address;
                companyForm.City = selectedItem.Data.City;
                companyForm.Zipcode = selectedItem.Data.Zipcode;

                Snackbar.Add("Company information loaded successfully!", Severity.Success);
                Logger.LogInformation("Selected CVR: {CVR} - {Company}", selectedItem.Data.Vat, selectedItem.Data.Name);
            }
        }
        finally
        {
            isLoading = false;
            isSelecting = false;
            StateHasChanged();
        }
    }

    private async Task SaveForm()
    {
        if (!CanSave())
        {
            Snackbar.Add("Please select a company first", Severity.Warning);
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            // Simulate API call delay
            await Task.Delay(1000);

            // Here you would typically send the form data to your API
            // var response = await Http.PostAsJsonAsync("api/companies", companyForm);

            Logger.LogInformation("Saved company: {CVR} - {Name}", companyForm.CvrNumber, companyForm.Name);
            Snackbar.Add("Company information saved successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving company information for CVR: {CVR}", companyForm.CvrNumber);
            Snackbar.Add($"Error saving company information: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ClearForm()
    {
        selectedCvr = null;
        companyForm = new CompanyForm();
        lastErrorMessage = string.Empty;
        lastSearchValue = string.Empty;
        lastSearchStats = null;

        Logger.LogDebug("Form cleared");
        Snackbar.Add("Form cleared", Severity.Info);
        StateHasChanged();
    }

    public void Dispose()
    {
        searchCache.Clear();
        Logger.LogDebug("CVR AutoComplete component disposed");
    }
}