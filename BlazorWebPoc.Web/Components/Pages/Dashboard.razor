@page "/home"
@using BlazorWebPoc.Web.Client
@using BlazorWebPoc.Web.Models
@using MudBlazor

@inject ProductsClient productsClient

<div class="productDash">

<MudLayout>
        <MudMenu Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" >
            <MudMenuItem>Logout</MudMenuItem>
            <MudMenuItem OnClick="@Toggle">Menu</MudMenuItem>
        </MudMenu>
    <MudDrawer @bind-Open="_drawerOpen" Label="Email" Anchor="Anchor.Left" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/home" Match="NavLinkMatch.All">Home</MudNavLink>
            <MudNavLink Href="/login">Login</MudNavLink>
            <MudNavLink Href="/AddProduct">Add Product</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer Class="pa-4">
            @* <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Toggle">
                Toggle Menu
            </MudButton> *@
            <div class="contents">
                <h1>Products</h1>
            </div>
            <MudGrid Class="mt-4">
                @if (products == null)
                {
                    <MudText Typo="Typo.h6">Loading products...</MudText>
                }
                else
                {
                    @foreach (var product in products)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard>
                                <MudCardMedia Image="@GetImageSrc(product.Image)" Height="200" />
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">@product.Name</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                }
            </MudGrid>
        </MudContainer>
    </MudMainContent>
</MudLayout>
</div>
@code {
    private bool _drawerOpen = true;

    private void Toggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    // example - replace with your real model
    private List<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        try
        {

            products = await productsClient.GetProducts();
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
            // Handle error - maybe show a message to user
            products = new List<Product>();
        }
    }

    private string GetImageSrc(byte[] imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0)
            return string.Empty;

        var base64 = Convert.ToBase64String(imageBytes);
        return $"data:image/png;base64,{base64}";
    }

}
